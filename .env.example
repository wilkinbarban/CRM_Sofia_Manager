# ==============================================================================
# CASA DE ASSADOS SOFIA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate with your actual credentials.
# NEVER commit real API keys, secrets, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE & REALTIME)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_INTERNAL_URL=http://api-gw:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------------------------
# 3. ARTIFICIAL INTELLIGENCE & BUSINESS ROUTE
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
SOFIA_AI_GENERATION_ENABLED=true


# ------------------------------------------------------------------------------
# 4. WHATSAPP GATEWAY (EVOLUTION API / CLOUD API)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=asados-sofia
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ------------------------------------------------------------------------------
# 6. PAYMENTS (MERCADO PAGO — PIX & CARD)
# ------------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------------------------------------------
# 8. CACHE & RATE LIMITING (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Internal durable Mercado Pago recovery worker. Use a random high-entropy value;
# it is required by Docker Compose and is never exposed to the browser.
MERCADO_PAGO_RECOVERY_SECRET=
# Optional; the container defaults to 60 seconds.
MERCADO_PAGO_RECOVERY_INTERVAL_SECONDS=60
PAYMENT_PROOF_MAINTENANCE_SECRET=
PAYMENT_PROOF_MAINTENANCE_INTERVAL_SECONDS=60
PAYMENT_PROOF_CANONICAL_INGEST_ENABLED=false
WHATSAPP_PAYMENT_PROOF_INGEST_ENABLED=false
# Telegram PDF intake remains independently closed unless explicitly enabled at Web startup.
TELEGRAM_PAYMENT_PROOF_INGEST_ENABLED=false
# Web action boundary only; direct authenticated SQL/RPC remains governed by the database admin-only contract.
PAYMENT_PROOF_RESTORE_ENABLED=false

# Sofia customer memory (fatos_cliente). Closed by default: no fact is extracted,
# no fact reaches the prompt, and the existing behaviour is unchanged while it is false.
# Only the exact string "true" opens the gate.
SOFIA_CUSTOMER_MEMORY_ENABLED=false
